FROM alpine:latest AS builder

RUN apk add --no-cache git

ARG REPO_URL=https://github.com/dandolinsky1/malamhomework.git
ARG BRANCH=master

RUN git clone -b ${BRANCH} ${REPO_URL} /app-source


#---
FROM node:18-alpine

WORKDIR /app

COPY --from=builder /app-source/package*.json ./

RUN npm install --production

COPY --from=builder /app-source /app

EXPOSE 3000

CMD ["node", "server.js"]